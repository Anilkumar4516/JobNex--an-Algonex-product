# =================================================================
# JobNex Environment Configuration Template (.env.example)
# Copy this file to .env and configure your environment variables.
# =================================================================

# -----------------------------------------------------------------
# 1. Database Configuration (MySQL)
# -----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=jobnex

# -----------------------------------------------------------------
# 2. Google Gemini AI API Configuration
# Get a free key at https://aistudio.google.com/
# If blank, JobNex automatically uses built-in smart AI fallback engine.
# -----------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------
# 3. Candidate & Auto-Apply Settings
# -----------------------------------------------------------------
APPLICANT_NAME=Your Full Name
APPLICANT_EMAIL=your_email@example.com
RESUME_PDF_PATH=
MIN_MATCH_SCORE=40
MAX_APPLICATIONS_PER_DAY=10

# -----------------------------------------------------------------
# 4. SMTP Email Dispatcher (For sending approved applications & referrals)
# -----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# -----------------------------------------------------------------
# 5. External Job Search APIs (Optional)
# -----------------------------------------------------------------
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# -----------------------------------------------------------------
# 6. Daily Job Matcher & Scheduler Settings
# -----------------------------------------------------------------
DAILY_TIMEZONE=Asia/Kolkata
DAILY_JOBS_PER_KEYWORD=10
DAILY_MAX_JOBS=30
DAILY_RETAIN_DAYS=7